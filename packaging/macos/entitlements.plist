<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT

  What the hardened runtime is asked to permit.

  disable-library-validation is the load-bearing one: a hardened app may
  normally only load libraries signed by Apple or by its own team, and
  libmpv comes from Homebrew, signed by neither. Without this the signed
  app starts, reaches for libmpv.2.dylib, and playback is simply gone.
  The day libmpv ships inside the bundle signed with the same identity,
  this entitlement can go.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
