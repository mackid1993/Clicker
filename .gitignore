/target
/dist

# Vendored FFmpeg: the source checkout and the build output. Neither is
# committed. `scripts\build-ffmpeg.ps1` reproduces both from a pinned tag, and
# a build tree full of object files is not something a repository should carry.
/third_party/ffmpeg-src
/third_party/ffmpeg

# Vendored mpv: the source checkout and the build output, on the same terms as
# FFmpeg above. `scripts\build-mpv.ps1` reproduces both from a pinned tag.
/third_party/mpv-src
/third_party/mpv
# One set of built dependencies per architecture, and one FFmpeg checkout per
# architecture with them. mpv needs FFmpeg built by gcc or clang, and the tree
# above is patched for MSVC, so the two cannot share one checkout; FFmpeg
# builds in-tree, so x64 and arm64 cannot share one either.
/third_party/mpv-deps*
/third_party/ffmpeg-mingw-src*
packaging/flatpak/generated-sources.json
/_todo
